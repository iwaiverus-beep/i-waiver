# iWaiver — environment template.
#
# Copy to .env.local and fill in. .env.local is gitignored; this file is not and
# must never contain a real value.
#
#   cp .env.local.example .env.local
#
# THE ONE RULE: NEXT_PUBLIC_ is shipped to the browser. Anything with that prefix
# is public, permanently, to anyone who opens devtools. Everything else stays on
# the server. Putting the service role key behind NEXT_PUBLIC_ hands every visitor
# full read/write on every table with RLS bypassed.

# --- Supabase: client-side (safe to expose) --------------------------------
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase: server-side only (NEVER prefix these) -----------------------
# Bypasses RLS entirely. This is the key the signing-link flow runs under, since
# an accountless borrower has no auth.uid() to write a policy against.
SUPABASE_SERVICE_ROLE_KEY=

# Account-level personal access token, used by the Supabase CLI and the MCP
# server for migrations and schema work. Not an app runtime secret.
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# --- Signing links ----------------------------------------------------------
# REQUIRED. Server-side pepper mixed into signing_links.token_hash. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this invalidates every outstanding link, which is the intended
# emergency lever. Changing it in an environment with live links WILL break them.
SIGNING_LINK_TOKEN_PEPPER=

# --- Where this deployment lives --------------------------------------------
# Signing links are absolute. Without this, links point at localhost:3000, which
# is fine locally and useless anywhere else. Vercel's own URL is used as a
# fallback when this is unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Delivery (email first; SMS is the fast follow) ------------------------
# Resend. Without a key the app still runs: emails are written to the server log
# and recorded as transport `console`, never as a delivered message. That is a
# development convenience, not a fallback to rely on.
RESEND_API_KEY=
EMAIL_FROM="iWaiver <onboarding@resend.dev>"

# SMS is deliberately not wired yet. `delivery_channel` is already an enum, so
# adding it is configuration rather than a migration. If SMS is wanted near
# launch, start A2P 10DLC registration early — it takes weeks.

# --- Coverage service --------------------------------------------------------
# The agreements app calls coverage over HTTP, through the same endpoints a
# partner platform would use, with a credential of its own. Optional: when unset,
# a value is derived from the service role key so a fresh checkout works. Set it
# explicitly to rotate it independently.
COVERAGE_INTERNAL_KEY=

# --- Carrier quote-and-bind API ---------------------------------------------
# Not read yet. Coverage is mocked behind the real interface for this milestone;
# see lib/coverage/carrier.ts. Wiring a real carrier means a second
# implementation of CarrierClient and nothing else.
CARRIER_API_BASE_URL=
CARRIER_API_KEY=

# --- Not yet wired ------------------------------------------------------------
# Premium is carrier-collected for this milestone, so Stripe is not in the path.
# The abstraction exists (payments.collector); the platform-collected branch is
# not implemented.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Identity verification. Until this is set, the compliance gate records the
# identity check as `skipped` — which is what actually happened — rather than
# passing it.
IDV_VENDOR_API_KEY=
