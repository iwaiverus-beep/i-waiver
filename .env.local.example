# iWaiver — environment template. NEVER put a real value in this file.
#
# This one is tracked. Copy it to .env.local, which is gitignored, and fill it
# in there. A secret committed here is a secret in the history forever, and
# rotating it afterwards does not remove it from anybody who already cloned.
#
# THE ONE RULE: NEXT_PUBLIC_ is shipped to the browser. Anything with that prefix
# is public, permanently, to anyone who opens devtools. Everything else stays on
# the server. Putting the service role key behind NEXT_PUBLIC_ hands every visitor
# full read/write on every table with RLS bypassed.
#
# Generated from .env.local with every value stripped. Add a variable to both
# files in the same commit — the one that only reaches .env.local is the one a
# fresh checkout discovers by crashing.

# --- Supabase: client-side (safe to expose) --------------------------------
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase: server-side only (NEVER prefix these) -----------------------
# Bypasses RLS entirely. This is the key the signing-link flow runs under, since
# an accountless borrower has no auth.uid() to write a policy against.
SUPABASE_SERVICE_ROLE_KEY=

# Account-level personal access token, used by the Supabase CLI and the MCP
# server for migrations and schema work. Not an app runtime secret.
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# REQUIRED for support emulation (Admin > Lenders > View as a customer).
# Dashboard > Project Settings > API > JWT Settings > JWT Secret.
#
# This is what PostgREST verifies every access token against, so a token signed
# with it is accepted exactly as a customer’s own would be. That is how the
# View-as screens read a customer’s data without signing in as them and
# touching their account. It can mint a token for ANY user, so treat it as the
# most sensitive value in this file: never NEXT_PUBLIC_, never logged.
#
# Left empty on purpose. Emulation reports itself unavailable while it is blank
# rather than appearing to work, which is the state you want if it is unset.
SUPABASE_JWT_SECRET=

# --- Signing links ----------------------------------------------------------
# REQUIRED. Server-side pepper mixed into signing_links.token_hash. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this invalidates every outstanding link, which is the intended
# emergency lever. Changing it in an environment with live links WILL break them.
SIGNING_LINK_TOKEN_PEPPER=

# --- Where this deployment lives --------------------------------------------
# Signing links are absolute. Without this, links point at localhost:3000, which
# is fine locally and useless anywhere else. Vercel's own URL is used as a
# fallback when this is unset.
NEXT_PUBLIC_SITE_URL=

# --- Delivery (email first; SMS is the fast follow) ------------------------
# Resend. Without a key the app still runs: emails are written to the server log
# and recorded as transport `console`, never as a delivered message. That is a
# development convenience, not a fallback to rely on.
RESEND_API_KEY=

# Verifies Resend's delivery webhooks — bounces, spam complaints, delivery
# receipts. Until this is set, a bounced signing link is invisible: the send
# succeeds, Resend accepts the message, and the only signal is the borrower
# never signing, days later, for a reason nothing on the screen can show.
# See app/api/webhooks/resend/route.ts and migration 20260901000035.
#
# Empty is the safe default and a silent one. The endpoint refuses EVERY request
# while this is unset — an open one would let anyone mark a borrower's link
# bounced and send a lender chasing an address that was fine — so nothing can
# write a false delivery status, and nothing can write a true one either.
#
# Resend dashboard → Webhooks → Add Endpoint
#   Endpoint URL:  https://www.i-waiver.com/api/webhooks/resend
#   Events:        email.sent, email.delivered, email.delivery_delayed,
#                  email.bounced, email.complained
# Then open the endpoint and copy its Signing Secret. It starts `whsec_`, and it
# is shown on the endpoint's own page — it is not the API key above.
#
# Set it in BOTH places or it works in neither where it matters: here for local
# development, and in Vercel (Project → Settings → Environment Variables, all
# three environments) for the site people actually use. A value added in Vercel
# does not take effect until the next deployment.
RESEND_WEBHOOK_SECRET=

# Which OAuth buttons the login page offers. Comma separated: google, azure, apple.
# Leave empty until the provider is actually configured in Supabase — a button
# for a provider nobody set up is a dead end that reads as a broken product.
NEXT_PUBLIC_OAUTH_PROVIDERS=

# --- Google sign-in ----------------------------------------------------------
# Read only by the setup step, never by the running app. Supabase holds these and
# talks to Google server-side; the browser never sees either value.
#
# Create them at console.cloud.google.com:
#   APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
#   Application type: Web application
#
# The redirect URI Google asks for is SUPABASE'S address, not this site's. Google
# returns to Supabase, which then returns to us. Paste exactly:
#
#   https://ivlsyqkilzsjwijfymvp.supabase.co/auth/v1/callback
#
# Getting that line wrong is the usual failure, and the error surfaces at Google
# where nothing here can see it.
#
# Why that URI is a random string and not i-waiver.com: it names the server that
# actually receives Google's answer, and that server is Supabase, not us. Google
# hands the user to Supabase; Supabase reads the response and only then sends
# them on to i-waiver.com. Putting our own domain there fails with
# redirect_uri_mismatch. Checked 2026-09-01.
#
# To make it read auth.i-waiver.com, Supabase itself has to answer on our domain,
# which is the Custom Domain add-on: Pro plan (~$25/mo) plus the add-on (~$10/mo).
# This project's Supabase org is on Free, so the API refuses both that and the
# cheaper vanity subdomain. Nothing technical is blocking it, only the plan.
#
# If we buy it, four things change together or sign-in breaks:
#   1. Enable the add-on in the Supabase dashboard
#   2. Add the verification DNS records -- i-waiver.com lives in the LEADLYNK
#      Cloudflare account, not the iWaiver one
#   3. Swap NEXT_PUBLIC_SUPABASE_URL here and in Vercel to the new host
#   4. Update the Google redirect URI above and Supabase's redirect allow-list
#
# Free in the meantime: the Branding page of the same Google console screen sets
# the app name, logo and home page. That is the part users actually read on the
# consent screen; the supabase.co host stays in the plumbing but stops being the
# headline.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

EMAIL_FROM=

# SMS is deliberately not wired yet. `delivery_channel` is already an enum, so
# adding it is configuration rather than a migration. If SMS is wanted near
# launch, start A2P 10DLC registration early — it takes weeks.

# --- Coverage service --------------------------------------------------------
# The agreements app calls coverage over HTTP, through the same endpoints a
# partner platform would use, with a credential of its own. Optional: when unset,
# a value is derived from the service role key so a fresh checkout works. Set it
# explicitly to rotate it independently.
COVERAGE_INTERNAL_KEY=

# --- Deployment automation (scripts/setup-deploy.mjs) -----------------------
#
# Read ONLY by the setup script, never by the running app.
#
# These use iWaiver-specific names on purpose. This machine has a LeadLynk
# CLOUDFLARE_API_TOKEN in the ambient environment — so nothing in this repo looks
# for the conventional name, and that token cannot be picked up by accident.
#
# The Vercel token must come from the i-waiver team. The Cloudflare token cannot:
# the i-waiver.com zone currently lives in the LeadLynk Cloudflare account (see
# "Deployment accounts" in CLAUDE.md), so its token is issued there but scoped to
# that single zone and can reach nothing else in it. The script's preflight
# refuses to run if either one reaches anything it should not.

# Vercel → Account Settings → Tokens → Create.
# Scope it to the i-waiver team. A token that reaches more than one team is
# rejected, so there is never ambiguity about where this deploys.
# GitHub, for pushing to iwaiverus-beep/iwaiver. Fine-grained token,
# Repository access: only that repo, Permissions: Contents = Read and write.
IWAIVER_GITHUB_TOKEN=

IWAIVER_VERCEL_TOKEN=
AI_GATEWAY_API_KEY=

# Issue this from the Cloudflare account that holds the zone — currently
# LeadLynk, not i-waiver. My Profile → API Tokens → Create Token.
#   Permissions:     Zone → DNS → Edit
#   Zone Resources:  Include → Specific zone → i-waiver.com
# A token that can see any other zone is rejected.
IWAIVER_CLOUDFLARE_API_TOKEN=

# --- Carrier quote-and-bind API ---------------------------------------------
# Not read yet. Coverage is mocked behind the real interface for this milestone;
# see lib/coverage/carrier.ts. Wiring a real carrier means a second
# implementation of CarrierClient and nothing else.
CARRIER_API_BASE_URL=
CARRIER_API_KEY=

# --- Not yet wired ------------------------------------------------------------
# Premium is carrier-collected for this milestone, so Stripe is not in the path.
# The abstraction exists (payments.collector); the platform-collected branch is
# not implemented.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Identity verification. Until this is set, the compliance gate records the
# identity check as `skipped` — which is what actually happened — rather than
# passing it.
IDV_VENDOR_API_KEY=

# Created by Vercel CLI
VERCEL_OIDC_TOKEN=

# Where a new partner application is announced internally. Without it the
# application is still saved and nobody is told about it.
PARTNER_NOTIFICATIONS_EMAIL=
