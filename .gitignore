# Secrets — never commit
.env
.env.local
.env.*.local
*.pem
*.key

# Claude Code — personal settings and local permission grants
.claude/settings.local.json

# Supabase CLI
.branches/
.temp/
supabase/.temp/

# Vercel
.vercel

# Node
node_modules/
.next/
out/
npm-debug.log*
yarn-error.log*

# OS
Thumbs.db
.DS_Store

# tsc --incremental cache
tsconfig.tsbuildinfo

.vercel

# Everything env-shaped is ignored by default, so a new .env.something cannot be
# committed by accident. The template is the single exception, named exactly
# rather than by a pattern: `!.env*.example` would also un-ignore a file somebody
# creates while debugging, and the whole point of the blanket rule is that
# nothing gets out unless it was named on purpose.
#
# .env.local.example must never contain a real value. It is generated from
# .env.local with every value stripped.
.env*
!.env.local.example
